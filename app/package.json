  "build": {
    "appId": "com.nishidsb.ryzaassistant",
    "productName": "Partner.execute(me);",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*"
    ],
    "asarUnpack": [
      "src/main/resources/*.png",
      "src/main/resources/*.ps1",
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "resources/screen/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Partner.execute(me);",
      "artifactName": "Partner.execute(me);-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Partner.execute(me);-Portable-${version}.${ext}"
    }
  },
